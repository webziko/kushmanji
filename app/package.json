{
  "name": "kushmanji",
  "productName": "Kushmanji",
  "version": "0.1.0",
  "description": "An unofficial Windows AI video editor built on HyperFrames, supporting Claude Code, Codex and Antigravity (Gemini).",
  "author": "Kushmanji contributors",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:study": "node scripts/smoke.mjs --study",
    "smoke:agent": "node scripts/smoke.mjs --agent",
    "smoke:codex": "node scripts/smoke.mjs --agent=codex",
    "smoke:antigravity": "node scripts/smoke.mjs --agent=antigravity",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "hyperframes": "0.8.169"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "26.15.3"
  }
}
